{
  "name": "dsh-contextos-devops",
  "version": "1.48.128",
  "type": "module",
  "description": "ContextOS DevOps for DeepSeek Harness: one dashboard for cluster nodes, project spaces, apps, avatars, PM boards and IoT devices, with an in-app Copilot that can deploy and scaffold.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "vendor/xterm/*",
    "vendor/three/*",
    "vendor/leaflet/*",
    "src/client/**",
    "build/**",
    "assets/**",
    "LICENSE",
    "assets/icon-180.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build:client": "node build/client.mjs && node scripts/gate.mjs && node scripts/load-check.mjs && node scripts/hook-order-check.mjs && node scripts/op-check.mjs && node scripts/install-check.mjs && node scripts/store-check.mjs && node scripts/ui-check.mjs && node scripts/ui-probe.mjs --soft && node scripts/dup-check.mjs && node scripts/css-check.mjs && node scripts/i18n-check.mjs && node scripts/i18n-lint.mjs && node scripts/context-check.mjs && node scripts/docs-check.mjs && node scripts/docs-budget.mjs --check && node scripts/bench-chat.mjs && node scripts/publish-check.mjs",
    "watch:client": "node build/client.mjs --watch",
    "check:ui": "node scripts/ui-check.mjs",
    "check:css": "node scripts/css-check.mjs",
    "check:probe": "node scripts/ui-probe.mjs",
    "check:context": "node scripts/context-check.mjs",
    "verify:factory": "node scripts/accept-factory.mjs",
    "check:i18n": "node scripts/i18n-check.mjs && node scripts/i18n-lint.mjs",
    "gate": "node scripts/gate.mjs",
    "verify:ui": "node scripts/ui-verify.mjs",
    "release": "npm run build:client && node scripts/ui-verify.mjs",
    "check:hooks": "node scripts/hook-order-check.mjs",
    "check:ops": "node scripts/op-check.mjs",
    "check:install": "node scripts/install-check.mjs",
    "check:store": "node scripts/store-check.mjs",
    "check:docs": "node scripts/docs-check.mjs",
    "check:load": "node scripts/load-check.mjs",
    "stats:ledger": "node scripts/ledger-stats.mjs",
    "check:budget": "node scripts/docs-budget.mjs --check",
    "push:all": "node scripts/push-all.mjs",
    "catalog:pr": "node scripts/catalog-pr.mjs",
    "check:publish": "node scripts/publish-check.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "check:prompt": "node scripts/bench-chat.mjs",
    "new": "node scripts/scaffold.mjs",
    "check:extend": "node scripts/scaffold.mjs --check",
    "check:dup": "node scripts/dup-check.mjs",
    "check:i18n-lint": "node scripts/i18n-lint.mjs"
  },
  "license": "MIT",
  "author": {
    "name": "shy",
    "url": "https://shylinux.com"
  },
  "homepage": "https://github.com/contextos-devops/dsh-contextos-devops#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contextos-devops/dsh-contextos-devops.git"
  },
  "bugs": {
    "url": "https://github.com/contextos-devops/dsh-contextos-devops/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "contextos",
    "devops",
    "deploy",
    "copilot",
    "cluster",
    "project-management"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <1.0.0"
  }
}
