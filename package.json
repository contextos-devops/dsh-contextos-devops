{
  "name": "@local/contextos-devops-dsh",
  "version": "1.43.8",
  "private": true,
  "type": "module",
  "description": "ContextOS DevOps for DeepSeek Harness: tech dashboard for cluster nodes, project spaces, platform apps and data.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "vendor/xterm/*",
    "vendor/three/*",
    "vendor/leaflet/*",
    "src/client/**",
    "build/**",
    "assets/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build:client": "node build/client.mjs && node scripts/gate.mjs && node scripts/hook-order-check.mjs && node scripts/ui-check.mjs && node scripts/i18n-check.mjs && node scripts/context-check.mjs",
    "watch:client": "node build/client.mjs --watch",
    "check:ui": "node scripts/ui-check.mjs",
    "check:context": "node scripts/context-check.mjs",
    "check:i18n": "node scripts/i18n-check.mjs",
    "gate": "node scripts/gate.mjs",
    "verify:ui": "node scripts/ui-verify.mjs",
    "release": "npm run build:client && node scripts/ui-verify.mjs",
    "check:hooks": "node scripts/hook-order-check.mjs"
  }
}
